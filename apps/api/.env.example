# AuthKit Security Configuration
# IMPORTANT: AUTHKIT_SECRET_KEY must equal the Supabase JWT secret so that
# tokens issued here verify against Supabase RLS (see CLAUDE.md JWT contract).
AUTHKIT_SECRET_KEY=
# Supabase Postgres connection (async driver). The sqlite fallback is sandbox-only
# and requires `aiosqlite` (not installed) — set a real URL for InStayOS.
AUTHKIT_DATABASE_URL=postgresql+asyncpg://postgres:[password]@[host]:5432/postgres

# CORS — comma-separated browser origins allowed to call the API (Next.js frontend)
CORS_ORIGINS=http://localhost:3000

# Cookie Settings
AUTHKIT_COOKIE_SECURE=False
AUTHKIT_COOKIE_SAMESITE=lax

# Email Settings
AUTHKIT_ENABLE_SMTP=False
# AUTHKIT_SMTP_HOST=
# AUTHKIT_SMTP_PORT=587
# AUTHKIT_SMTP_USERNAME=
# AUTHKIT_SMTP_PASSWORD=
# AUTHKIT_SMTP_FROM_EMAIL=
