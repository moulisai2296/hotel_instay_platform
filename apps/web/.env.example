# InStayOS web (Next.js) — copy to .env.local and fill in.
# ONLY NEXT_PUBLIC_* values are exposed to the browser. Never put the
# Supabase service-role key here — it is backend-only.

# FastAPI backend base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Supabase (anon key only — used for direct "my rows" reads + realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
